---
import Base from '../../../layouts/Base.astro';
import Art from '../../../components/rol/Art.astro';
import EpisodeCard from '../../../components/rol/EpisodeCard.astro';
import Row from '../../../components/rol/Row.astro';
import { allSeries, allEpisodes, neighbours, formatDuration, thumbFor } from '../../../lib/catalog';
import type { Episode, Series } from '../../../lib/types';

export const getStaticPaths = () =>
  allSeries.flatMap((series) => allEpisodes(series).map((episode) => ({ params: { serie: series.slug, ep: episode.id }, props: { series, episode } })));

const { series: s, episode: e } = Astro.props as { series: Series; episode: Episode };
const { prev, next } = neighbours(s, e.id);
const code = s.seasons.length > 1 ? `Temporada ${e.season} · Episodio ${e.number}` : `Episodio ${e.number} de ${s.episodeCount}`;
const season = s.seasons.find((x) => x.number === e.season)!;
const stamp = (t: number) => `${Math.floor(t / 3600) ? Math.floor(t / 3600) + ':' : ''}${String(Math.floor((t % 3600) / 60)).padStart(Math.floor(t / 3600) ? 2 : 1, '0')}:${String(t % 60).padStart(2, '0')}`;
---
<Base title={`${e.title} · ${s.title}`} description={e.synopsis.logline ?? s.tagline} accent={s.color}>
  <div class="watch wrap">
    <nav class="crumbs label"><a href="/rol">Series</a> / <a href={s.href}>{s.title}</a></nav>

    {prev && e.synopsis.previously && (
      <aside class="previously">
        <span class="label">Anteriormente en {s.title}</span>
        <p>{e.synopsis.previously}</p>
      </aside>
    )}

    <div class="player" data-player data-id={e.id} data-series={s.slug} data-demo={e.demo ? '1' : undefined}>
      <Art thumb={e.demo ? undefined : thumbFor(e.id, 'maxres')} color={s.color} label={String(e.number).padStart(2, '0')} caption={s.title} eager />
      <button type="button" class="play" data-play aria-label={`Reproducir ${e.title}`}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>
      </button>
      {e.demo && <p class="demo-note">Episodio de ejemplo: aparecerá el video cuando conectemos las playlists reales.</p>}
    </div>

    <div class="info">
      <div class="main">
        <span class="label">{code}</span>
        <h1>{e.title}</h1>
        <div class="meta">
          {e.publishedAt && <span>{new Date(e.publishedAt).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}</span>}
          {e.duration && <span>{formatDuration(e.duration)}</span>}
          {e.views ? <span>{e.views.toLocaleString('es-CO')} vistas</span> : null}
        </div>
        {(e.synopsis.summary || e.synopsis.logline) && <p class="lede">{e.synopsis.summary ?? e.synopsis.logline}</p>}
        {e.synopsis.characters?.length ? (
          <p class="chars"><span class="label">En este episodio</span> {e.synopsis.characters.join(', ')}</p>
        ) : null}
        {!e.demo && <a class="yt" href={`https://www.youtube.com/watch?v=${e.id}`} target="_blank" rel="noopener">Ver en YouTube y apoyar el canal ↗</a>}
      </div>

      {e.synopsis.moments?.length ? (
        <section class="moments">
          <span class="label">Momentos clave</span>
          <ol>
            {e.synopsis.moments.map((m) => (
              <li><button type="button" data-seek={m.t}><span class="t">{stamp(m.t)}</span>{m.text}</button></li>
            ))}
          </ol>
        </section>
      ) : null}
    </div>

    {next && (
      <a href={next.href} class="next" data-ep={next.id}>
        <span class="label">Siguiente episodio</span>
        <div class="next-art"><Art thumb={next.thumb} color={s.color} label={String(next.number).padStart(2, '0')} caption={s.title} /></div>
        <div>
          <span class="next-title">{next.title}</span>
          {next.synopsis.logline && <p class="muted">{next.synopsis.logline}</p>}
        </div>
      </a>
    )}
  </div>

  <Row title={s.seasons.length > 1 ? `Temporada ${season.number}: ${season.title}` : 'Todos los episodios'}>
    {season.episodes.map((x) => <EpisodeCard episode={x} series={s} />)}
  </Row>
</Base>

<script>
  import { save, readAll, paintCards } from '../../../lib/progress';

  let apiReady: Promise<void> | undefined;
  function loadApi() {
    return (apiReady ??= new Promise((resolve) => {
      (window as any).onYouTubeIframeAPIReady = () => resolve();
      const s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      document.head.append(s);
    }));
  }

  function init() {
    paintCards();
    const box = document.querySelector<HTMLElement>('[data-player]');
    if (!box || box.dataset.demo) return;
    const { id, series } = box.dataset as { id: string; series: string };
    let player: any;

    async function start(at?: number) {
      if (player) {
        if (at != null) player.seekTo(at, true), player.playVideo();
        return;
      }
      const resume = at ?? Math.max(0, (readAll()[id]?.t ?? 0) - 5);
      await loadApi();
      const mount = document.createElement('div');
      box!.append(mount);
      box!.classList.add('playing');
      const YT = (window as any).YT;
      player = new YT.Player(mount, {
        host: 'https://www.youtube-nocookie.com',
        videoId: id,
        playerVars: { autoplay: 1, start: Math.floor(resume), rel: 0, modestbranding: 1, playsinline: 1 },
      });
      // Guardamos el punto exacto cada pocos segundos para "Continuar viendo"
      const timer = setInterval(() => {
        if (!document.contains(box)) return clearInterval(timer);
        const t = player.getCurrentTime?.();
        const d = player.getDuration?.();
        if (t && d) save(id, { t, d, series });
      }, 4000);
    }

    box.querySelector('[data-play]')?.addEventListener('click', () => start());
    document.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((b) =>
      b.addEventListener('click', () => {
        box.scrollIntoView({ behavior: 'smooth', block: 'center' });
        start(Number(b.dataset.seek));
      }),
    );
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .watch { padding-top: 96px; display: grid; gap: 28px; max-width: 1280px; margin-inline: auto; }
  .crumbs a:hover { color: var(--paper); }
  .previously { border-left: 3px solid var(--accent, var(--signal)); padding: 4px 0 4px 18px; max-width: 70ch; }
  .previously p { margin-top: 6px; font-size: 1.05rem; font-style: italic; color: rgb(241 234 219 / 0.85); }

  .player { position: relative; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius); overflow: hidden; box-shadow: 0 30px 80px -30px color-mix(in oklab, var(--accent, #000), transparent 40%); }
  .player :global(.art) { position: absolute; inset: 0; height: 100%; border-radius: 0; }
  .player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .player.playing :global(.art), .player.playing .play { display: none; }
  .play { position: absolute; inset: 0; margin: auto; width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; background: var(--signal); color: var(--signal-ink); transition: transform 0.25s var(--ease); }
  .play:hover { transform: scale(1.08); }
  .play svg { width: 38px; margin-left: 5px; }
  .demo-note { position: absolute; left: 0; right: 0; bottom: 0; padding: 12px 18px; background: rgb(0 0 0 / 0.6); font-size: 0.9rem; }

  .info { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 360px); gap: clamp(28px, 4vw, 64px); }
  .main { display: grid; gap: 14px; align-content: start; }
  h1 { font-size: clamp(2rem, 3vw + 1rem, 3.4rem); font-weight: 820; font-stretch: 75%; line-height: 1; letter-spacing: -0.01em; text-wrap: balance; }
  .chars { font-size: 0.95rem; }
  .chars .label { margin-right: 8px; }
  .yt { font-size: 0.9rem; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; width: fit-content; }
  .yt:hover { color: var(--paper); }

  .moments { display: grid; gap: 10px; align-content: start; }
  .moments ol { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .moments button { width: 100%; text-align: left; display: grid; grid-template-columns: 64px 1fr; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; transition: color 0.2s; }
  .moments button:hover { color: var(--accent, var(--signal)); }
  .t { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--accent, var(--signal)); }

  .next { display: grid; grid-template-columns: auto 200px minmax(0, 1fr); gap: 20px; align-items: center; padding: 18px; background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); transition: border-color 0.2s; }
  .next:hover { border-color: var(--line-strong); }
  .next .label { writing-mode: vertical-rl; transform: rotate(180deg); color: var(--accent, var(--signal)); }
  .next-title { font-weight: 700; font-size: 1.15rem; }
  .next p { font-size: 0.92rem; margin-top: 4px; }

  @media (max-width: 860px) {
    .info { grid-template-columns: 1fr; }
    .next { grid-template-columns: 120px minmax(0, 1fr); }
    .next .label { writing-mode: initial; transform: none; grid-column: 1 / -1; }
  }
</style>
