---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/rol/Hero.astro';
import EpisodeCard from '../../../components/rol/EpisodeCard.astro';
import SeriesCard from '../../../components/rol/SeriesCard.astro';
import Row from '../../../components/rol/Row.astro';
import EpisodeIndex from '../../../components/rol/EpisodeIndex.astro';
import { allSeries, allEpisodes, formatDuration } from '../../../lib/catalog';
import type { Series } from '../../../lib/types';

export const getStaticPaths = () => allSeries.map((series) => ({ params: { serie: series.slug }, props: { series } }));
const { series: s } = Astro.props as { series: Series };
const others = allSeries.filter((x) => x.slug !== s.slug);
const recap = s.seasons.flatMap((x) => x.episodes).filter((e) => e.synopsis.logline || e.synopsis.summary);
const channel = allEpisodes(s).find((e) => (e as any).channel) as any;
const years = allEpisodes(s).map((e) => e.publishedAt?.slice(0, 4)).filter(Boolean).sort();
const span = years.length ? (years[0] === years.at(-1) ? years[0] : `${years[0]}–${years.at(-1)}`) : s.year;
---
<Base title={s.title} description={s.tagline ?? s.synopsis} accent={s.color} image={s.backdrop ? `https://i.ytimg.com/vi/${s.backdrop}/maxresdefault.jpg` : undefined}>
  <Hero slides={[s]} detail />

  <section class="episodes" data-reveal>
    <header class="wrap head">
      <h2>Episodios</h2>
      {s.seasons.length > 1 && (
        <div class="segmented" role="tablist" aria-label="Temporadas" data-seasons>
          <span class="seg-ind" aria-hidden="true"></span>
          {s.seasons.map((x, i) => (
            <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-season-tab={x.number}>
              {x.special ? 'Especial' : `Temporada ${x.number}`}
            </button>
          ))}
        </div>
      )}
    </header>
    {s.seasons.map((season, si) => (
      <div class="season" data-season={season.number} hidden={si > 0}>
        <Row title={season.special ? season.title : `${season.episodes.length} episodios`}>
          {season.episodes.map((e) => <EpisodeCard episode={e} series={s} detailed />)}
        </Row>
      </div>
    ))}
  </section>

  {recap.length > 0 && (
    <section class="recap wrap" data-reveal>
      <h2>Ponte al día</h2>
      <ol>
        {recap.map((e) => (
          <li><a href={e.href}><span class="n">{e.number}</span><span>{e.synopsis.logline ?? e.synopsis.summary}</span></a></li>
        ))}
      </ol>
    </section>
  )}

  {s.cast?.length ? (
    <section class="cast wrap" data-reveal>
      <h2>Reparto</h2>
      <ul>
        {s.cast.map((c) => (
          <li>
            <span class="avatar" aria-hidden="true">{c.name.replace(/["“”][^"“”]*["“”]/g, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('')}</span>
            <strong>{c.name}</strong>
            <span class="muted">{c.role}{c.played_by ? ` · ${c.played_by}` : ''}</span>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  <section class="info wrap" data-reveal>
    <h2>Información</h2>
    <dl>
      <div><dt>Género</dt><dd>{s.kind}</dd></div>
      {span && <div><dt>Emisión</dt><dd>{span}</dd></div>}
      <div><dt>Episodios</dt><dd>{s.episodeCount}</dd></div>
      {s.runtime > 0 && <div><dt>Duración total</dt><dd>{formatDuration(s.runtime)}</dd></div>}
      {s.views > 0 && <div><dt>Vistas en YouTube</dt><dd>{s.views.toLocaleString('es-CO')}</dd></div>}
      {channel?.channel && <div><dt>Canal</dt><dd>{channel.channel}</dd></div>}
    </dl>
  </section>

  {others.length > 0 && (
    <Row title="Más series">
      {others.map((x) => <SeriesCard series={x} />)}
    </Row>
  )}

  <EpisodeIndex />
</Base>

<script>
  import { paintCards } from '../../../lib/progress';

  function init() {
    paintCards();
    const seg = document.querySelector<HTMLElement>('[data-seasons]');
    if (!seg) return;
    const ind = seg.querySelector<HTMLElement>('.seg-ind')!;
    const tabs = [...seg.querySelectorAll<HTMLButtonElement>('[data-season-tab]')];
    const place = (t: HTMLElement) => { ind.style.transform = `translateX(${t.offsetLeft - 4}px)`; ind.style.width = `${t.offsetWidth}px`; };
    place(tabs[0]);
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      place(tab);
      document.querySelectorAll<HTMLElement>('[data-season]').forEach((l) => {
        const show = l.dataset.season === tab.dataset.seasonTab;
        l.hidden = !show;
        if (show) l.animate([{ opacity: 0, transform: 'translateX(24px)' }, { opacity: 1, transform: 'none' }], { duration: 500, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
      });
    }));
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  h2 { font-size: clamp(1.2rem, 0.8vw + 1rem, 1.55rem); font-weight: 760; letter-spacing: -0.025em; }
  .episodes { margin-top: 8px; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .episodes :global(.row) { margin-top: 18px; }
  .episodes :global(.row h2) { font-size: 1rem; color: var(--text-2); font-weight: 600; letter-spacing: -0.01em; }

  .segmented { position: relative; display: inline-flex; padding: 4px; border-radius: 10px; background: rgb(255 255 255 / 0.07); box-shadow: inset 0 0 0 1px var(--line); }
  .seg-ind { position: absolute; top: 4px; bottom: 4px; left: 4px; border-radius: 7px; background: rgb(255 255 255 / 0.16); box-shadow: 0 2px 10px rgb(0 0 0 / 0.3); transition: transform 0.5s var(--spring), width 0.5s var(--spring); }
  .segmented button { position: relative; height: 32px; padding: 0 14px; border-radius: 7px; font-size: 0.86rem; font-weight: 600; color: var(--text-2); transition: color 0.2s; }
  .segmented button[aria-selected='true'] { color: var(--text); }

  .recap { margin-top: 64px; display: grid; gap: 18px; }
  .recap ol { list-style: none; padding: 0; columns: 2 360px; column-gap: 48px; }
  .recap li { break-inside: avoid; border-top: 1px solid var(--line); }
  .recap a { display: grid; grid-template-columns: 36px 1fr; gap: 8px; padding: 12px 0; font-size: 0.94rem; color: var(--text-2); transition: color 0.2s; }
  .recap a:hover { color: var(--text); }
  .recap .n { font-weight: 700; color: var(--text-3); font-variant-numeric: tabular-nums; }

  .cast { margin-top: 64px; display: grid; gap: 20px; }
  .cast ul { list-style: none; padding: 0; display: flex; gap: 28px; overflow-x: auto; scrollbar-width: none; }
  .cast li { display: grid; justify-items: center; text-align: center; gap: 4px; width: 128px; flex-shrink: 0; font-size: 0.88rem; }
  .avatar { width: 104px; height: 104px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 8px; font-size: 1.9rem; font-weight: 800; letter-spacing: -0.04em; background: radial-gradient(circle at 30% 20%, color-mix(in oklab, var(--accent, #666), white 20%), color-mix(in oklab, var(--accent, #333), black 50%)); }

  .info { margin-top: 64px; display: grid; gap: 18px; }
  dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px 32px; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  dt { font-size: 0.8rem; color: var(--text-3); font-weight: 600; }
  dd { margin: 2px 0 0; font-weight: 560; }
</style>
