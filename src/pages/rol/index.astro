---
import Base from '../../layouts/Base.astro';
import Billboard from '../../components/rol/Billboard.astro';
import Row from '../../components/rol/Row.astro';
import EpisodeCard from '../../components/rol/EpisodeCard.astro';
import SeriesCard from '../../components/rol/SeriesCard.astro';
import { allSeries, allEpisodes } from '../../lib/catalog';

const featured = allSeries.find((s) => s.featured) ?? allSeries[0];
const startHere = allSeries.filter((s) => s.start_here);
const top = [...allSeries].sort((a, b) => b.views - a.views || b.episodeCount - a.episodeCount).slice(0, 10);
const bySlug = Object.fromEntries(allSeries.map((s) => [s.slug, s]));
const everything = allSeries.flatMap((s) => allEpisodes(s));
const latest = [...everything].sort((a, b) => (b.publishedAt ?? '').localeCompare(a.publishedAt ?? '')).slice(0, 12);
---
<Base title="Series" description="Todas las series de rol de JuanSGuarnizo, ordenadas por temporada y episodio.">
  {featured && <Billboard series={featured} />}

  <Row title="Continuar viendo" id="continue" hidden>
    <!-- se llena en el navegador con el progreso guardado -->
  </Row>

  {startHere.length > 0 && (
    <Row title="Empieza aquí" note="Series cortas o fáciles de seguir">
      {startHere.map((s) => <SeriesCard series={s} />)}
    </Row>
  )}

  <Row title="Lo más visto" note="Top de la comunidad">
    {top.map((s, i) => <SeriesCard series={s} rank={i + 1} />)}
  </Row>

  <Row title="Recién subidos">
    {latest.map((e) => <EpisodeCard episode={e} series={bySlug[e.series]} showSeries />)}
  </Row>

  {allSeries.map((s) => (
    <Row title={s.title} note={s.kind}>
      {allEpisodes(s).map((e) => <EpisodeCard episode={e} series={s} />)}
    </Row>
  ))}

  <!-- Tarjetas de todos los episodios, para armar "Continuar viendo" sin pedir nada al servidor -->
  <template id="ep-pool">
    {allSeries.map((s) => allEpisodes(s).map((e, i, list) => (
      <div data-pool={e.id} data-series={s.slug} data-next={list[i + 1]?.id ?? ''}>
        <EpisodeCard episode={e} series={s} showSeries />
      </div>
    )))}
  </template>
</Base>

<script>
  import { readAll, isFinished, paintCards } from '../../lib/progress';

  function continueRow() {
    const row = document.getElementById('continue');
    const pool = document.getElementById('ep-pool') as HTMLTemplateElement | null;
    if (!row || !pool) return;
    const track = row.querySelector('[data-track]')!;
    track.replaceChildren();
    const all = readAll();
    // El episodio más reciente de cada serie; si ya lo terminó, el siguiente.
    const latestBySeries = new Map<string, [string, number]>();
    for (const [id, p] of Object.entries(all)) {
      const prev = latestBySeries.get(p.series);
      if (!prev || p.at > prev[1]) latestBySeries.set(p.series, [id, p.at]);
    }
    const picks = [...latestBySeries.values()].sort((a, b) => b[1] - a[1]).map(([id]) => {
      const node = pool.content.querySelector<HTMLElement>(`[data-pool="${CSS.escape(id)}"]`);
      if (node && isFinished(all[id]) && node.dataset.next) return node.dataset.next;
      return node ? id : null;
    });
    for (const id of picks) {
      const node = id && pool.content.querySelector(`[data-pool="${CSS.escape(id)}"] > *`);
      if (node) track.append(node.cloneNode(true));
    }
    row.hidden = track.children.length === 0;
  }

  document.addEventListener('astro:page-load', () => {
    continueRow();
    paintCards();
  });
</script>
