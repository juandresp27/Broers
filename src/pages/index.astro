---
import Base from '../layouts/Base.astro';
import SeriesCard from '../components/rol/SeriesCard.astro';
import EpisodeCard from '../components/rol/EpisodeCard.astro';
import Row from '../components/rol/Row.astro';
import { allSeries, allEpisodes } from '../lib/catalog';

const bySlug = Object.fromEntries(allSeries.map((s) => [s.slug, s]));
const latest = allSeries.flatMap((s) => allEpisodes(s)).sort((a, b) => (b.publishedAt ?? '').localeCompare(a.publishedAt ?? '')).slice(0, 12);
const wall = latest.concat(latest).slice(0, 18);
const sections = [
  { href: '/clips', title: 'Clips', text: 'Los mejores momentos con etiquetas y el clip del día.' },
  { href: '/zona', title: 'Zona Broers', text: 'Fanart, memes, encuestas, frases y el glosario de chistes internos.' },
  { href: '/juegos', title: 'Juegos', text: '¿Qué personaje eres?, bingo del stream, predicciones y ¿Quién lo dijo?' },
  { href: '/album', title: 'Álbum', text: 'Colecciona las láminas de personajes y momentos míticos.' },
];
---
<Base>
  <section class="hero">
    <div class="wall" aria-hidden="true">
      {wall.map((e) => <img src={`https://i.ytimg.com/vi/${e.id}/mqdefault.jpg`} alt="" loading="eager" />)}
    </div>
    <div class="content wrap">
      <span class="status" data-status><span class="dot"></span><span data-status-text>JuanSGuarnizo</span></span>
      <h1 class="title-xl">La casa de<br />los Broers</h1>
      <p class="lede">Todas las series de rol de Juan ordenadas como en una plataforma de streaming, más los clips, los juegos y los memes de la comunidad.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/rol"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>Ver series</a>
        <a class="btn btn-glass" href="https://www.twitch.tv/juansguarnizo" target="_blank" rel="noopener">Canal de Twitch</a>
      </div>
    </div>
  </section>

  <Row title="Series" href="/rol">
    {allSeries.map((s) => <SeriesCard series={s} />)}
  </Row>

  <Row title="Lo último">
    {latest.map((e) => <EpisodeCard episode={e} series={bySlug[e.series]} showSeries />)}
  </Row>

  <section class="soon wrap" data-reveal>
    <h2>Muy pronto</h2>
    <div class="grid">
      {sections.map((s, i) => (
        <article class="card" style={`--i:${i}`}>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  async function status() {
    const el = document.querySelector<HTMLElement>('[data-status]');
    if (!el) return;
    try {
      const res = await fetch('https://decapi.me/twitch/uptime/juansguarnizo');
      const text = (await res.text()).trim();
      const live = res.ok && !/offline|error|not found/i.test(text);
      el.dataset.live = String(live);
      el.querySelector('[data-status-text]')!.textContent = live ? `En vivo ahora · ${text}` : 'Sin stream en este momento';
    } catch {}
  }
  document.addEventListener('astro:page-load', status);
</script>

<style>
  .hero { position: relative; min-height: min(92vh, 860px); display: grid; align-items: end; overflow: hidden; }
  .wall {
    position: absolute; inset: -10% -20% auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px;
    transform: rotate(-8deg) translateY(-6%); opacity: 0.55; animation: drift 60s linear infinite alternate;
  }
  .wall img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; }
  @keyframes drift { to { transform: rotate(-8deg) translate(-6%, -2%); } }
  .hero::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 90% at 15% 100%, rgb(10 10 12 / 0.96) 30%, rgb(10 10 12 / 0.6) 60%, rgb(10 10 12 / 0.3)), linear-gradient(0deg, var(--bg), transparent 40%); }
  .content { position: relative; z-index: 1; display: grid; gap: 18px; justify-items: start; padding-bottom: clamp(56px, 9vh, 110px); }
  .content > * { animation: up 1s var(--spring) both; }
  .content > :nth-child(2) { animation-delay: 0.08s; }
  .content > :nth-child(3) { animation-delay: 0.16s; }
  .content > :nth-child(4) { animation-delay: 0.24s; }
  @keyframes up { from { opacity: 0; transform: translateY(24px); } }
  .title-xl { font-size: clamp(3rem, 8vw, 7.5rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .status { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border-radius: 999px; background: rgb(255 255 255 / 0.1); backdrop-filter: blur(20px); font-size: 0.82rem; font-weight: 620; color: var(--text-2); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-3); }
  [data-live='true'] { color: #ffb3ad; background: rgb(255 69 58 / 0.16); }
  [data-live='true'] .dot { background: var(--live); }

  .soon { margin-top: 80px; display: grid; gap: 18px; }
  h2 { font-size: clamp(1.2rem, 0.8vw + 1rem, 1.55rem); font-weight: 760; letter-spacing: -0.025em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; }
  .card { padding: 24px; border-radius: var(--r-lg); background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02)); box-shadow: inset 0 0 0 1px var(--line); min-height: 170px; display: grid; align-content: end; gap: 6px; transition: transform 0.5s var(--spring), background-color 0.3s; }
  .card:hover { transform: translateY(-4px); }
  .card h3 { font-size: 1.3rem; font-weight: 760; letter-spacing: -0.03em; }
  .card p { color: var(--text-2); font-size: 0.93rem; }
</style>
