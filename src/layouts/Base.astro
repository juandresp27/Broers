---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';

interface Props { title?: string; description?: string; accent?: string }
const { title, description = 'La casa de los Broers: series de rol, clips, juegos y todo lo de JuanSGuarnizo.', accent } = Astro.props;
const fullTitle = title ? `${title} · Broers` : 'Broers';
---
<!doctype html>
<html lang="es" style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0e0c" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader />
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <p class="display">Broers</p>
      <p class="muted">Hecho por la comunidad. No es un sitio oficial de JuanSGuarnizo.</p>
    </footer>
  </body>
</html>

<style>
  .site-footer { margin-top: 120px; padding-block: 48px 64px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .site-footer .display { font-size: clamp(3rem, 10vw, 8rem); color: var(--ink-3); -webkit-text-stroke: 1px var(--line-strong); }
  .site-footer p:last-child { font-size: 0.85rem; max-width: 36ch; }
</style>
