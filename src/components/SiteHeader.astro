---
const links = [
  { href: '/', label: 'Inicio', icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/rol', label: 'Series', icon: 'M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm4 15h8' },
  { href: '/clips', label: 'Clips', icon: 'M7 4v16l13-8z' },
  { href: '/zona', label: 'Zona Broers', icon: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z' },
  { href: '/juegos', label: 'Juegos', icon: 'M6 9h12a3 3 0 0 1 3 3v2a3 3 0 0 1-5.2 2L15 15H9l-.8 1A3 3 0 0 1 3 14v-2a3 3 0 0 1 3-3zm2 2v3m-1.5-1.5h3M15.5 12h.01M17.5 13.5h.01' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="topbar" data-topbar>
  <a href="/" class="brand" aria-label="Broers, inicio">
    <span class="mark" aria-hidden="true"></span>
    <span>Broers</span>
  </a>

  <nav class="nav" aria-label="Principal" data-nav>
    <span class="indicator" aria-hidden="true" data-indicator></span>
    {links.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} data-nav-link>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={l.icon} /></svg>
        <span>{l.label}</span>
      </a>
    ))}
  </nav>

  <a class="live" href="https://www.twitch.tv/juansguarnizo" target="_blank" rel="noopener" data-live hidden>
    <span class="dot"></span>En vivo
  </a>
</header>

<script>
  let bound = false;
  function setup() {
    const bar = document.querySelector<HTMLElement>('[data-topbar]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const ind = document.querySelector<HTMLElement>('[data-indicator]');
    if (!bar || !nav || !ind) return;

    const onScroll = () => document.querySelector('[data-topbar]')?.classList.toggle('scrolled', scrollY > 8);
    onScroll();
    if (!bound) addEventListener('scroll', onScroll, { passive: true });

    // El indicador se desliza bajo el enlace activo y sigue al cursor
    const links = [...nav.querySelectorAll<HTMLElement>('[data-nav-link]')];
    const active = links.find((l) => l.hasAttribute('aria-current'));
    const moveTo = (el?: HTMLElement, instant = false) => {
      if (!el) return (ind.style.opacity = '0');
      if (instant) ind.style.transition = 'none';
      ind.style.opacity = '1';
      ind.style.transform = `translateX(${el.offsetLeft}px)`;
      ind.style.width = `${el.offsetWidth}px`;
      if (instant) requestAnimationFrame(() => (ind.style.transition = ''));
    };
    // Arranca desde la posición anterior para que se vea el deslizamiento al cambiar de página
    const prev = sessionStorage.getItem('nav-x');
    if (prev && active) {
      const [x, w] = prev.split(',');
      ind.style.transition = 'none';
      ind.style.transform = `translateX(${x}px)`;
      ind.style.width = `${w}px`;
      ind.style.opacity = '1';
      requestAnimationFrame(() => requestAnimationFrame(() => { ind.style.transition = ''; moveTo(active); }));
    } else moveTo(active, true);
    links.forEach((l) => {
      l.addEventListener('mouseenter', () => matchMedia('(hover: hover)').matches && moveTo(l));
      l.addEventListener('click', () => active && sessionStorage.setItem('nav-x', `${active.offsetLeft},${active.offsetWidth}`));
    });
    nav.addEventListener('mouseleave', () => moveTo(active));
    if (!bound) addEventListener('resize', () => document.dispatchEvent(new Event('nav:resize')));
    document.addEventListener('nav:resize', () => moveTo(active, true));
    bound = true;

    liveStatus();
  }

  // Estado en vivo vía decapi.me (texto plano, sin llaves). Se guarda 2 minutos para no repetir la consulta.
  async function liveStatus() {
    let live: boolean | null = null;
    try {
      const cached = JSON.parse(sessionStorage.getItem('live') ?? 'null');
      if (cached && Date.now() - cached.at < 120_000) live = cached.live;
    } catch {}
    if (live === null) {
      try {
        const res = await fetch('https://decapi.me/twitch/uptime/juansguarnizo');
        const text = await res.text();
        live = res.ok && !/offline|error|not found/i.test(text);
        sessionStorage.setItem('live', JSON.stringify({ live, at: Date.now() }));
      } catch { live = false; }
    }
    document.querySelectorAll<HTMLElement>('[data-live]').forEach((el) => (el.hidden = !live));
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .topbar {
    position: fixed; inset: 0 0 auto; z-index: 60; height: 72px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding-inline: var(--gutter);
    transition: background-color 0.4s, backdrop-filter 0.4s, box-shadow 0.4s, height 0.4s var(--spring);
  }
  .topbar::before { /* degradado suave sobre el hero cuando no hay fondo */
    content: ''; position: absolute; inset: 0 0 -30px; z-index: -1; pointer-events: none;
    background: linear-gradient(rgb(0 0 0 / 0.55), transparent); transition: opacity 0.4s;
  }
  .topbar.scrolled {
    height: 60px; background: rgb(18 18 21 / 0.72);
    backdrop-filter: blur(28px) saturate(180%); -webkit-backdrop-filter: blur(28px) saturate(180%);
    box-shadow: 0 1px 0 var(--line);
  }
  .topbar.scrolled::before { opacity: 0; }

  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 820; font-size: 1.32rem; letter-spacing: -0.045em; justify-self: start; }
  .mark { width: 22px; height: 22px; border-radius: 7px; background: var(--brand); position: relative; box-shadow: 0 0 24px -4px rgb(255 194 26 / 0.6); }
  .mark::after { content: ''; position: absolute; inset: 6px 5px 6px 8px; background: #0a0a0c; clip-path: polygon(0 0, 100% 50%, 0 100%); }

  .nav {
    position: relative; display: flex; padding: 4px; border-radius: 999px;
    background: rgb(255 255 255 / 0.07); box-shadow: inset 0 0 0 1px var(--line);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  }
  .indicator {
    position: absolute; top: 4px; bottom: 4px; left: 0; border-radius: 999px; opacity: 0;
    background: rgb(255 255 255 / 0.14);
    transition: transform 0.55s var(--spring), width 0.55s var(--spring), opacity 0.3s;
  }
  .nav a { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 16px; border-radius: 999px; font-size: 0.9rem; font-weight: 580; color: var(--text-2); transition: color 0.25s; white-space: nowrap; }
  .nav a:hover, .nav a[aria-current] { color: var(--text); }
  .nav svg { width: 17px; height: 17px; display: none; }

  .live { justify-self: end; display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px; border-radius: 999px; background: rgb(255 69 58 / 0.16); color: #ffb3ad; font-size: 0.82rem; font-weight: 700; }
  .live .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live); animation: pulse 1.6s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgb(255 69 58 / 0.7); } 70%, 100% { box-shadow: 0 0 0 8px rgb(255 69 58 / 0); } }

  /* En celular la navegación baja a una barra inferior, como una app */
  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr auto; height: 56px; }
    .topbar.scrolled { height: 52px; }
    .nav {
      position: fixed; left: 12px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); justify-content: space-between;
      background: rgb(24 24 28 / 0.78); backdrop-filter: blur(28px) saturate(180%); -webkit-backdrop-filter: blur(28px) saturate(180%);
      box-shadow: inset 0 0 0 1px var(--line), 0 12px 40px -10px rgb(0 0 0 / 0.8);
    }
    .nav a { flex: 1; flex-direction: column; justify-content: center; gap: 2px; height: 50px; padding: 0 4px; font-size: 0.66rem; }
    .nav svg { display: block; width: 21px; height: 21px; }
    .indicator { top: 4px; bottom: 4px; }
  }
</style>
