---
import type { Series } from '../../lib/types';
import { allEpisodes, formatDuration } from '../../lib/catalog';
import Art from './Art.astro';

interface Props { series: Series; eyebrow?: string; compact?: boolean }
const { series: s, eyebrow = 'Serie destacada', compact = false } = Astro.props;
const first = allEpisodes(s)[0];
const hours = Math.round(s.runtime / 3600);
---
<section class:list={['billboard', { compact }]} style={`--c:${s.color}`}>
  <div class="backdrop" aria-hidden="true">
    <Art thumb={s.poster ? s.poster.replace('hqdefault', 'maxresdefault') : undefined} color={s.color} label={s.title.slice(0, 1)} duotone eager />
  </div>
  <div class="content wrap">
    <span class="label eyebrow"><span class="swatch"></span>{eyebrow}</span>
    <h1 class="display" transition:name={`title-${s.slug}`}>{s.title}</h1>
    {s.tagline && <p class="tagline">{s.tagline}</p>}
    <div class="meta">
      {s.year && <span>{s.year}</span>}
      {s.kind && <span>{s.kind}</span>}
      <span>{s.seasons.length > 1 ? `${s.seasons.length} temporadas` : `${s.episodeCount} episodios`}</span>
      {hours > 0 && <span>{hours} horas de historia</span>}
    </div>
    {!compact && s.synopsis && <p class="lede">{s.synopsis}</p>}
    <div class="actions">
      {first && (
        <a class="btn btn-primary" href={first.href} data-resume={s.slug}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>
          <span data-resume-label>Ver desde el inicio</span>
        </a>
      )}
      {!compact && <a class="btn btn-ghost" href={s.href}>Episodios y reparto</a>}
    </div>
  </div>
</section>

<style>
  .billboard { position: relative; min-height: min(88vh, 860px); display: grid; align-items: end; padding-top: 120px; padding-bottom: clamp(32px, 5vw, 64px); overflow: hidden; }
  .compact { min-height: min(70vh, 640px); }
  .backdrop { position: absolute; inset: 0 0 0 auto; width: min(100%, 78vw); }
  .backdrop :global(.art) { height: 100%; aspect-ratio: auto; border-radius: 0; }
  .backdrop::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, var(--ink) 0%, rgb(15 14 12 / 0.85) 28%, rgb(15 14 12 / 0.1) 70%),
      linear-gradient(0deg, var(--ink) 0%, transparent 45%);
  }
  .content { position: relative; display: grid; gap: 18px; max-width: 980px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--paper); }
  .swatch { width: 18px; height: 6px; background: var(--c); }
  h1 { font-size: clamp(4.2rem, 13vw, 12.5rem); margin-left: -0.04em; }
  .tagline { font-size: clamp(1.2rem, 1.4vw + 0.8rem, 1.9rem); font-weight: 500; font-stretch: 92%; line-height: 1.2; max-width: 30ch; text-wrap: balance; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  @media (max-width: 640px) {
    .backdrop { width: 100%; }
    .backdrop::after { background: linear-gradient(0deg, var(--ink) 25%, rgb(15 14 12 / 0.55) 70%, rgb(15 14 12 / 0.3)); }
  }
</style>
