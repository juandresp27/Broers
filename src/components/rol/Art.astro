---
// Imagen 16:9 de un video de YouTube. Con `hd` pide la versión grande y, si YouTube no la tiene, cae a la normal.
interface Props {
  video?: string; // id del video
  src?: string;
  hd?: boolean;
  color?: string;
  fallback?: string; // texto si no hay imagen
  eager?: boolean;
  name?: string; // transition:name para animar entre páginas
  class?: string;
}
const { video, src, hd = false, color = '#222', fallback, eager = false, name, class: cls } = Astro.props;
const url = src ?? (video ? `https://i.ytimg.com/vi/${video}/${hd ? 'maxresdefault' : 'hqdefault'}.jpg` : undefined);
const lowres = video ? `https://i.ytimg.com/vi/${video}/hqdefault.jpg` : undefined;
---
<div class:list={['art', cls]} style={`--c:${color}`} transition:name={name}>
  {hd && video && <img class="lq" src={`https://i.ytimg.com/vi/${video}/mqdefault.jpg`} alt="" decoding="async" fetchpriority="high" />}
  {url ? (
    <img
      src={url}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      data-fallback={hd ? lowres : undefined}
      onload="this.dataset.fallback && this.naturalWidth <= 120 ? (this.src = this.dataset.fallback, delete this.dataset.fallback) : this.classList.add('ready')"
      onerror="this.dataset.fallback ? (this.src = this.dataset.fallback, delete this.dataset.fallback) : this.remove()"
    />
  ) : (
    <span class="ph">{fallback}</span>
  )}
</div>

<style>
  .art {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; isolation: isolate;
    background: radial-gradient(120% 120% at 100% 0%, color-mix(in oklab, var(--c), white 10%), color-mix(in oklab, var(--c), black 70%));
  }
  .art img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s var(--ease-out), transform 0.8s var(--spring), filter 0.4s; }
  .art img:global(.ready) { opacity: 1; }
  .lq { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(14px) saturate(1.2); transform: scale(1.08); }
  .art img:not(.lq) { position: relative; }
  .ph { position: absolute; inset: auto 0 0; padding: 8%; font-weight: 800; font-size: 1.1rem; letter-spacing: -0.03em; }
</style>
