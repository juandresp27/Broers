---
import type { Series } from '../../lib/types';
import Art from './Art.astro';
interface Props { series: Series; rank?: number }
const { series: s, rank } = Astro.props;
---
<a href={s.href} class:list={['series-card', { ranked: rank }]}>
  {rank && <span class="rank display" aria-hidden="true">{rank}</span>}
  <div class="poster">
    <Art thumb={s.poster} color={s.color} label={s.title.slice(0, 1)} duotone class="tall" />
    <div class="over">
      <span class="label">{s.kind}</span>
      <span class="name display">{s.title}</span>
      <span class="count">{s.episodeCount} episodios</span>
    </div>
  </div>
</a>

<style>
  .series-card { position: relative; display: flex; align-items: flex-end; width: var(--card-w, clamp(170px, 17vw, 240px)); }
  .ranked { width: calc(var(--card-w, clamp(170px, 17vw, 240px)) * 1.45); }
  .rank {
    font-size: clamp(9rem, 15vw, 14rem); line-height: 0.74; margin-right: -0.12em; z-index: 0;
    color: var(--ink); -webkit-text-stroke: 2px var(--line-strong); letter-spacing: -0.06em;
    transition: -webkit-text-stroke-color 0.25s;
  }
  .series-card:hover .rank { -webkit-text-stroke-color: var(--signal); }
  .poster { position: relative; flex: 1 0 auto; width: var(--card-w, clamp(170px, 17vw, 240px)); z-index: 1; transition: transform 0.35s var(--ease); }
  .series-card:hover .poster { transform: translateY(-6px) rotate(-0.6deg); }
  .poster :global(.tall) { aspect-ratio: 3 / 4.2; }
  .poster :global(.tall .num) { font-size: 70cqh; right: auto; left: -4%; bottom: -10%; }
  .over { position: absolute; inset: auto 0 0; padding: 14px; display: grid; gap: 6px; background: linear-gradient(transparent, rgb(0 0 0 / 0.65)); }
  .over .label { color: rgb(255 255 255 / 0.8); }
  .name { font-size: clamp(1.9rem, 2.6vw, 2.6rem); line-height: 0.88; }
  .count { font-size: 0.8rem; color: rgb(255 255 255 / 0.75); }
</style>
